<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ═══════════════════════════════════════════════════════
         Spring Multi-Threaded Scheduler — Logback Configuration
         • One rolling appender per scheduler
         • Rolls to .gz archive when file size > 10 MB
         • Max 30 days history, 500 MB total cap
         ═══════════════════════════════════════════════════════ -->

    <property name="LOG_DIR"          value="logs"/>
    <property name="MAX_FILE_SIZE"    value="10MB"/>
    <property name="MAX_HISTORY"      value="30"/>
    <property name="TOTAL_SIZE_CAP"   value="500MB"/>
    <property name="PATTERN_CONSOLE"  value="%cyan(%d{yyyy-MM-dd HH:mm:ss.SSS}) %highlight(%-5level) %yellow([%thread]) %green(%logger{36}) — %msg%n"/>
    <property name="PATTERN_FILE"     value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{50} — %msg%n"/>

    <!-- ───────────────────────────────────────────────────────
         CONSOLE APPENDER
    ─────────────────────────────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN_CONSOLE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ───────────────────────────────────────────────────────
         MAIN app.log — Captures ALL scheduler output
         Rolls to app.%d{yyyy-MM-dd}.%i.log.gz when > 10 MB
    ─────────────────────────────────────────────────────────── -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- .gz extension triggers automatic gzip compression on rollover -->
            <fileNamePattern>${LOG_DIR}/archived/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
            <cleanHistoryOnStart>false</cleanHistoryOnStart>
        </rollingPolicy>

        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ───────────────────────────────────────────────────────
         EMAIL SCHEDULER — email-scheduler.log
    ─────────────────────────────────────────────────────────── -->
    <appender name="EMAIL_SCHEDULER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/email-scheduler.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/email-scheduler.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
        </encoder>
    </appender>

    <!-- ───────────────────────────────────────────────────────
         REPORT SCHEDULER — report-scheduler.log
    ─────────────────────────────────────────────────────────── -->
    <appender name="REPORT_SCHEDULER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/report-scheduler.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/report-scheduler.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
        </encoder>
    </appender>

    <!-- ───────────────────────────────────────────────────────
         CLEANUP SCHEDULER — cleanup-scheduler.log
    ─────────────────────────────────────────────────────────── -->
    <appender name="CLEANUP_SCHEDULER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/cleanup-scheduler.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/cleanup-scheduler.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
        </encoder>
    </appender>

    <!-- ───────────────────────────────────────────────────────
         NOTIFICATION SCHEDULER — notification-scheduler.log
    ─────────────────────────────────────────────────────────── -->
    <appender name="NOTIFICATION_SCHEDULER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/notification-scheduler.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/notification-scheduler.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
        </encoder>
    </appender>

    <!-- ───────────────────────────────────────────────────────
         DATA-SYNC SCHEDULER — datasync-scheduler.log
    ─────────────────────────────────────────────────────────── -->
    <appender name="DATASYNC_SCHEDULER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/datasync-scheduler.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/datasync-scheduler.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
        </encoder>
    </appender>

    <!-- ───────────────────────────────────────────────────────
         ERROR log — errors-only.log  (all schedulers combined)
    ─────────────────────────────────────────────────────────── -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/errors.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/errors.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATTERN_FILE}</pattern>
        </encoder>
    </appender>

    <!-- ═══════════════════════════════════════════════════════
         LOGGER BINDINGS
         Each scheduler class writes to its own file + app.log
         ═══════════════════════════════════════════════════════ -->

    <!-- Email Scheduler: writes to email-scheduler.log + app.log + console -->
    <logger name="com.scheduler.app.scheduler.EmailScheduler"
            level="DEBUG" additivity="false">
        <appender-ref ref="EMAIL_SCHEDULER_FILE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Report Scheduler -->
    <logger name="com.scheduler.app.scheduler.ReportScheduler"
            level="DEBUG" additivity="false">
        <appender-ref ref="REPORT_SCHEDULER_FILE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Cleanup Scheduler -->
    <logger name="com.scheduler.app.scheduler.CleanupScheduler"
            level="DEBUG" additivity="false">
        <appender-ref ref="CLEANUP_SCHEDULER_FILE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Notification Scheduler -->
    <logger name="com.scheduler.app.scheduler.NotificationScheduler"
            level="DEBUG" additivity="false">
        <appender-ref ref="NOTIFICATION_SCHEDULER_FILE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Data Sync Scheduler -->
    <logger name="com.scheduler.app.scheduler.DataSyncScheduler"
            level="DEBUG" additivity="false">
        <appender-ref ref="DATASYNC_SCHEDULER_FILE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Service layer also goes to app.log -->
    <logger name="com.scheduler.app.service" level="DEBUG" additivity="false">
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Exception handler -->
    <logger name="com.scheduler.app.exception" level="DEBUG" additivity="false">
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- ROOT: everything else at INFO level -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
